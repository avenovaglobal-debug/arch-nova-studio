pragma solidity ^0.8.24;

import {ERC721URIStorage} from "@openzeppelin/contracts/token/ERC721/extensions/ERC721URIStorage.sol";
import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";

/// @title ProjectOwnership
/// @notice On-chain registry and transferable digital certificate for ArchNova projects.
/// @dev A token represents control of this digital certificate only. It does not, by itself,
///      convey copyright, land title, building ownership, or other off-chain legal rights.
contract ProjectOwnership is ERC721URIStorage, AccessControl {
    bytes32 public constant PROJECT_CREATOR_ROLE = keccak256("PROJECT_CREATOR_ROLE");
    bytes32 public constant PROJECT_VERIFIER_ROLE = keccak256("PROJECT_VERIFIER_ROLE");

    uint256 private _nextTokenId = 1;

    struct ProjectRecord {
        bytes32 projectId;
        bytes32 contentHash;
        uint64 createdAt;
        uint64 updatedAt;
        bool verified;
    }

    mapping(uint256 tokenId => ProjectRecord) private _projects;
    mapping(bytes32 projectId => bool registered) public projectIdRegistered;

    error ZeroAddress();
    error ZeroHash();
    error EmptyMetadataURI();
    error ProjectAlreadyRegistered(bytes32 projectId);
    error NotProjectController();
    error UnchangedContentHash();

    event ProjectRegistered(
        uint256 indexed tokenId,
        bytes32 indexed projectId,
        bytes32 contentHash,
        address indexed initialOwner
    );
    event ProjectContentUpdated(
        uint256 indexed tokenId,
        bytes32 indexed projectId,
        bytes32 previousContentHash,
        bytes32 newContentHash
    );
    event ProjectVerificationChanged(uint256 indexed tokenId, bool verified, address indexed verifier);

    constructor(address initialAdmin) ERC721("ArchNova Project", "ANPROJECT") {
        if (initialAdmin == address(0)) revert ZeroAddress();
        _grantRole(DEFAULT_ADMIN_ROLE, initialAdmin);
    }

    /// @notice Registers a project and mints its digital ownership certificate.
    /// @param initialOwner Wallet that receives the certificate.
    /// @param projectId Stable identifier generated by ArchNova Studio.
    /// @param contentHash Hash of the canonical project version (never the private file itself).
    /// @param metadataURI Public or access-controlled metadata pointer; do not put secrets here.
    function registerProject(
        address initialOwner,
        bytes32 projectId,
        bytes32 contentHash,
        string calldata metadataURI
    ) external onlyRole(PROJECT_CREATOR_ROLE) returns (uint256 tokenId) {
        if (initialOwner == address(0)) revert ZeroAddress();
        if (projectId == bytes32(0) || contentHash == bytes32(0)) revert ZeroHash();
        if (bytes(metadataURI).length == 0) revert EmptyMetadataURI();
        if (projectIdRegistered[projectId]) revert ProjectAlreadyRegistered(projectId);

        tokenId = _nextTokenId++;
        uint64 timestamp = uint64(block.timestamp);

        projectIdRegistered[projectId] = true;
        _projects[tokenId] = ProjectRecord({
            projectId: projectId,
            contentHash: contentHash,
            createdAt: timestamp,
            updatedAt: timestamp,
            verified: false
        });

        _safeMint(initialOwner, tokenId);
        _setTokenURI(tokenId, metadataURI);

        emit ProjectRegistered(tokenId, projectId, contentHash, initialOwner);
    }

    /// @notice Updates a project's content commitment and metadata pointer.
    /// @dev Only the current token owner, an approved operator, or protocol admin may update it.
    function updateProjectContent(
        uint256 tokenId,
        bytes32 newContentHash,
        string calldata newMetadataURI
    ) external {
        if (newContentHash == bytes32(0)) revert ZeroHash();
        if (bytes(newMetadataURI).length == 0) revert EmptyMetadataURI();

        address currentOwner = ownerOf(tokenId);
        bool authorized = msg.sender == currentOwner
            || getApproved(tokenId) == msg.sender
            || isApprovedForAll(currentOwner, msg.sender)
            || hasRole(DEFAULT_ADMIN_ROLE, msg.sender);
        if (!authorized) revert NotProjectController();

        ProjectRecord storage project = _projects[tokenId];
        bytes32 previousHash = project.contentHash;
        if (newContentHash == previousHash) revert UnchangedContentHash();

        project.contentHash = newContentHash;
        project.updatedAt = uint64(block.timestamp);
        project.verified = false;
        _setTokenURI(tokenId, newMetadataURI);

        emit ProjectContentUpdated(tokenId, project.projectId, previousHash, newContentHash);
    }

    /// @notice Marks the current project version as verified by an authorized reviewer.
    function verifyProject(uint256 tokenId) external onlyRole(PROJECT_VERIFIER_ROLE) {
        ownerOf(tokenId); // Reverts for unknown token IDs.
        _projects[tokenId].verified = true;
        emit ProjectVerificationChanged(tokenId, true, msg.sender);
    }

    /// @notice Returns the on-chain record for a project certificate.
    function getProject(uint256 tokenId) external view returns (ProjectRecord memory) {
        ownerOf(tokenId);
        return _projects[tokenId];
    }

    function supportsInterface(bytes4 interfaceId)
        public
        view
        override(ERC721URIStorage, AccessControl)
        returns (bool)
    {
        return super.supportsInterface(interfaceId);
    }
}
